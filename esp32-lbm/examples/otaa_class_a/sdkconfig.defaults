# 1 ms ticks: the modem task sleeps in whole ticks
CONFIG_FREERTOS_HZ=1000

# Lets the LBM timer interrupt notify its dispatch task without a task hop
CONFIG_ESP_TIMER_SUPPORT_ISR_DISPATCH_METHOD=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Heltec WiFi LoRa 32 V3 / Wireless Tracker / Wireless Paper.
# Change in menuconfig (LoRa Basics Modem -> Board preset) for V4.2 or V4.3.
CONFIG_LBM_BOARD_HELTEC_V3=y
